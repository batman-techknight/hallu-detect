# Copy this to .env and adjust as needed. Never commit the real .env.

# --- Postgres ---
DATABASE_URL=postgresql+asyncpg://hguard:hguard@localhost:5432/hguard

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400

# --- Model serving (point at local vLLM servers or any OpenAI-compatible
# free endpoint, e.g. HF Inference Endpoints, Groq, OpenRouter free tier) ---
GENERATOR_BASE_URL=http://localhost:8001/v1
GENERATOR_MODEL=Qwen/Qwen2.5-7B-Instruct

JUDGE_BASE_URL=http://localhost:8002/v1
JUDGE_MODEL=meta-llama/Llama-3.1-8B-Instruct

CLAIM_EXTRACTOR_MODEL=Qwen/Qwen2.5-3B-Instruct

# --- Local HF models (embeddings + NLI), free & offline ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-base

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
